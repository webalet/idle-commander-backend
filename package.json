{
  "name": "idle-commander-backend",
  "version": "1.0.0",
  "description": "Idle Commander game server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.16.1",
    "bcryptjs": "2.4.3",
    "fastify": "4.28.1",
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/websocket": "10.0.1",
    "dotenv": "16.4.5",
    "zod": "3.23.8",
    "typescript": "5.5.3",
    "@types/node": "20.14.11",
    "@types/bcryptjs": "2.4.6"
  },
  "devDependencies": {
    "prisma": "5.16.1",
    "ts-node-dev": "2.0.0"
  }
}
