# Database — Supabase veya local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/idle_commander"

# JWT Secret — üretimde güçlü random string kullan
JWT_SECRET="change-this-to-a-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# Admin — veritabanı sıfırlama endpoint'i için (/admin/wipe)
# Güçlü random string kullan, sadece sen bil
ADMIN_SECRET="change-this-to-a-strong-random-secret"

# Tick interval (ms) — her bu kadar ms'de bir aktif dünyalar tick'lenir
WORLD_TICK_MS=5000

# Dünya uyku süresi (ms) — bu kadar süre aktif kullanıcı yoksa dünya uyur
WORLD_SLEEP_AFTER_MS=1800000
